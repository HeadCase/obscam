[Unit]
Description=ObsCam MediaMTX WebRTC relay
StartLimitIntervalSec=0
PartOf=obscam.target
Requires=obscam-media-network.service
After=obscam-media-network.service

[Service]
Type=exec
DynamicUser=yes
ExecStartPre=/opt/obscam/active/bin/verify-mediamtx /opt/obscam/active/bin/mediamtx /opt/obscam/active/config/mediamtx.yml /opt/obscam/active/config/mediamtx-linux-arm64.sha256 /opt/obscam/active/config/mediamtx-config.sha256
ExecStart=/opt/obscam/active/bin/mediamtx /opt/obscam/active/config/mediamtx.yml
NetworkNamespacePath=/run/netns/obscam-media
Restart=always
RestartSec=5s
TimeoutStopSec=10s
UMask=0077

# Favor the interactive relay over the low-priority sync worker. Deployed
# steady-state RSS is about 42 MiB, so these limits retain ample burst room.
CPUWeight=200
IOWeight=200
MemoryHigh=256M
MemoryMax=384M
OOMScoreAdjust=-250

# Pion requires netlink for ICE setup. Inside this namespace it can discover
# only the private media veth and loopback; browser endpoints are exact-address
# translations owned by obscam-media-network.service.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
