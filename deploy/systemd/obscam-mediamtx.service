[Unit]
Description=ObsCam MediaMTX WebRTC relay
StartLimitIntervalSec=0
Requires=obscam-media-network.service
After=obscam-media-network.service

[Service]
Type=exec
DynamicUser=yes
ExecStart=/usr/local/bin/mediamtx /etc/obscam/mediamtx.yml
NetworkNamespacePath=/run/netns/obscam-media
Restart=on-failure
RestartSec=5s

# Pion requires netlink for ICE setup. Inside this namespace it can discover
# only the private media veth and loopback; browser endpoints are exact-address
# translations owned by obscam-media-network.service.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
