[Unit]
Description=ObsCam isolated media network
StartLimitIntervalSec=0
PartOf=obscam.target
Before=obscam-mediamtx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/obscam/active/bin/setup-media-network start
ExecStop=/opt/obscam/active/bin/setup-media-network stop
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
NoNewPrivileges=yes

StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
