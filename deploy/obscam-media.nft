table inet obscam_media {
    set browser_addresses {
        type ipv4_addr
        elements = { 10.164.190.1, 192.168.1.200 }
    }

    set browser_networks {
        type ipv4_addr
        flags interval
        elements = { 10.164.190.0/24, 192.168.1.0/24 }
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr @browser_addresses tcp dport 8889 dnat ip to 169.254.218.2:8889
        ip daddr @browser_addresses udp dport 8189 dnat ip to 169.254.218.2:8189
    }

    chain output {
        type nat hook output priority -100; policy accept;
        ip daddr @browser_addresses tcp dport 8889 dnat ip to 169.254.218.2:8889
        ip daddr @browser_addresses udp dport 8189 dnat ip to 169.254.218.2:8189
    }

    chain input {
        type filter hook input priority -10; policy accept;
        iifname "obscam-media0" drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname "obscam-media0" ct state established,related accept
        oifname "obscam-media0" ct state established,related accept
        iifname "obscam-media0" ip saddr 169.254.218.2 ip daddr @browser_networks udp sport 8189 accept
        iifname "obscam-media0" drop
        oifname "obscam-media0" ct status dnat ip daddr 169.254.218.2 tcp dport 8889 accept
        oifname "obscam-media0" ct status dnat ip daddr 169.254.218.2 udp dport 8189 accept
        oifname "obscam-media0" drop
    }
}
