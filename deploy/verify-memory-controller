#!/bin/sh
set -eu

cgroup_root=${1:-/sys/fs/cgroup}

if [ "$#" -gt 1 ]; then
    echo "usage: $0 [CGROUP_ROOT]" >&2
    exit 2
fi

controllers=$cgroup_root/cgroup.controllers
if [ ! -r "$controllers" ]; then
    echo "verify-memory-controller: cgroup controller inventory is unavailable: $controllers" >&2
    exit 1
fi

if ! grep -qw memory "$controllers"; then
    echo "verify-memory-controller: memory cgroup controller is unavailable" >&2
    exit 1
fi
