{
  "name": "obscam-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node web/scripts/build-assets.mjs",
    "prototype:gre-231": "python3 -m http.server 4173 -d web/prototypes/gre-231",
    "test": "npm run build && node --test web/tests/*.test.mjs",
    "test:browser": "npm run typecheck:browser && playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.playwright.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "5.9.3"
  }
}
