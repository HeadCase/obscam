#!/bin/sh
set -eu

version=1.19.3
archive=mediamtx_v${version}_linux_arm64.tar.gz
archive_sha256=9e5b38a5b5fcab1916341b024031b2fc5dc6a2059baed9ba3f3b0d3768d231a8
destination=${1:-/usr/local/bin/mediamtx}
backup=${destination}.previous

if [ -x "$destination" ] && [ "$($destination --version)" = "v$version" ]; then
    echo "MediaMTX v$version is already installed at $destination"
    exit 0
fi

if [ "$(uname -s)" != Linux ]; then
    echo "MediaMTX pin supports Linux only" >&2
    exit 1
fi

case "$(uname -m)" in
    aarch64|arm64) ;;
    *)
        echo "MediaMTX pin supports 64-bit ARM only" >&2
        exit 1
        ;;
esac

staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT HUP INT TERM

url=https://github.com/bluenviron/mediamtx/releases/download/v${version}/${archive}
curl --fail --location --silent --show-error --output "$staging/$archive" "$url"
printf '%s  %s\n' "$archive_sha256" "$staging/$archive" | sha256sum --check
tar -xzf "$staging/$archive" -C "$staging" mediamtx

staged_destination=${destination}.new
install -m 0755 "$staging/mediamtx" "$staged_destination"
staged_version=$($staged_destination --version)
if [ "$staged_version" != "v$version" ]; then
    echo "staged MediaMTX reported $staged_version, expected v$version" >&2
    rm -f "$staged_destination"
    exit 1
fi

if [ -e "$destination" ]; then
    if [ -e "$backup" ]; then
        echo "refusing to replace existing backup $backup" >&2
        rm -f "$staged_destination"
        exit 1
    fi
    cp -p "$destination" "$backup"
fi
mv "$staged_destination" "$destination"

installed_version=$($destination --version)
if [ "$installed_version" != "v$version" ]; then
    echo "installed MediaMTX reported $installed_version, expected v$version" >&2
    exit 1
fi

echo "installed MediaMTX $installed_version at $destination"
if [ -e "$backup" ]; then
    echo "previous binary preserved at $backup"
fi
